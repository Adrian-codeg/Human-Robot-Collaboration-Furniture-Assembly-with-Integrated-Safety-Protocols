<?xml version="1.0"?>
<robot name="bin_base">

<link name="base_link">
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.5 1.5 0.7" />
    </geometry>
  </collision>

  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.5 1.5 0.7" />
    </geometry>
  </visual>

 <inertial>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <mass value="10.0" />
    <inertia
      ixx="1.0" ixy="0.0"  ixz="0.0"
      iyy="1.0" iyz="0.0"
      izz="1.0" />
  </inertial>
  </link>

<gazebo reference="base_link">
  <material>Gazebo/White</material>
    <mu1>5</mu1>
    <mu2>5</mu2>
</gazebo>

</robot>
